{
  "name": "narko-klient",
  "version": "0.1.0",
  "description": "Typed client for NRK TV (psapi.nrk.no) with small, validated results for AI agents that build playlists. Never throws, no dependencies.",
  "keywords": [
    "nrk",
    "nrk-tv",
    "psapi",
    "tv",
    "streaming",
    "playlist",
    "ai-agent",
    "typescript"
  ],
  "homepage": "https://github.com/davidtoska/nrk-klient#readme",
  "bugs": {
    "url": "https://github.com/davidtoska/nrk-klient/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtoska/nrk-klient.git"
  },
  "license": "ISC",
  "author": "David Toska",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.js",
    "clean:all": "node scripts/clean.js --all",
    "test": "tsc && node scripts/run-tests.js build/test/offline",
    "test:live": "tsc && node scripts/run-tests.js build/test/live --test-timeout=900000",
    "record": "tsc && node scripts/record-fixtures.js",
    "verify:package": "node scripts/verify-package.js",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
